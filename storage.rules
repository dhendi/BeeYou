rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolated per-user storage (strictly authenticated)
    // Direct client uploads by users go to users/{userId}/** and remain fully functional
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
    }

    // Isolated per-family custom icons and media
    // Strictly requires authenticated user and verified family membership
    // Revocation-aware authorization:
    // 1. Direct client uploads by members are placed in users/{userId}/**
    // 2. Writes to shared family storage are restricted to verified family owners and admins
    // 3. Reads from shared family storage enforce revocation checks (revoked claims and resource.metadata.revokedMembers)
    match /beeyou/families/{familyCode}/{allPaths=**} {
      // Demo isolated sandbox
      allow read: if request.auth != null 
        && familyCode == 'BEE-DEMO' 
        && request.auth.token.get('email', '') == 'demo@beeyou.app';
      allow write: if request.auth != null 
        && familyCode == 'BEE-DEMO' 
        && request.auth.token.get('email', '') == 'demo@beeyou.app'
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));

      // Real families: strictly forbidden to demo account, strictly tied to user's familyCode
      // Revocation-aware: checks both token claims and file-level revocation metadata safely
      allow read: if request.auth != null 
        && familyCode != 'BEE-DEMO'
        && request.auth.token.get('email', '') != 'demo@beeyou.app'
        && request.auth.token.familyCode == familyCode
        && request.auth.token.get('revoked', false) != true
        && request.auth.token.get('memberStatus', 'active') != 'revoked'
        && (resource.metadata == null || resource.metadata.get('revokedMembers', '') == '' || !(request.auth.uid in resource.metadata.get('revokedMembers', '').split(',')));

      // Writes restricted to authorized family owner or backend
      allow write: if request.auth != null 
        && familyCode != 'BEE-DEMO'
        && request.auth.token.get('email', '') != 'demo@beeyou.app'
        && request.auth.token.familyCode == familyCode
        && (request.auth.token.get('role', '') == 'owner' || request.auth.token.get('isOwner', false) == true || request.auth.token.get('admin', false) == true)
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'))
        && request.resource.metadata != null
        && request.resource.metadata.get('familyCode', '') == familyCode
        && request.resource.metadata.get('userId', '') == request.auth.uid;
    }

    // Shared durable TTS audio cache across all users and serverless instances
    // Public read allows fast global CDN distribution; writes strictly restricted to trusted backend/admin
    match /tts_cache/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
        && (request.auth.token.get('admin', false) == true || request.auth.token.get('role', '') == 'admin' || request.auth.token.get('backend', false) == true)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Block all unauthenticated or root access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
