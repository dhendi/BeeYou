rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolated per-user storage (strictly authenticated)
    // Direct client uploads by users go to users/{userId}/** and remain fully functional
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
    }

    // Isolated per-family custom icons and media
    // Authoritative membership and revocation verification through Cloud Firestore:
    // 1. Direct client uploads by users go to users/{userId}/**
    // 2. Shared family Storage files check live Firestore membership and revocation status
    // 3. Revoked users immediately lose read, write, update, and delete permissions even if holding an unexpired token with familyCode claim
    // 4. Zero reliance on mutable file metadata for membership authorization

    function isRealFamily(familyCode) {
      return familyCode != 'BEE-DEMO' && request.auth.token.get('email', '') != 'demo@beeyou.app';
    }

    function isNotRevoked(familyCode) {
      return request.auth.token.get('revoked', false) != true
        && request.auth.token.get('memberStatus', 'active') != 'revoked'
        && !firestore.exists(/databases/(default)/documents/beeyou_families/$(familyCode)/revokedMembers/$(request.auth.uid));
    }

    function isCurrentFamilyMember(familyCode) {
      return request.auth != null 
        && isRealFamily(familyCode)
        && request.auth.token.familyCode == familyCode
        && isNotRevoked(familyCode)
        && (
          firestore.exists(/databases/(default)/documents/beeyou_families/$(familyCode)/members/$(request.auth.uid))
          || (firestore.exists(/databases/(default)/documents/beeyou_families/$(familyCode)) && firestore.get(/databases/(default)/documents/beeyou_families/$(familyCode)).data.ownerUid == request.auth.uid)
        );
    }

    function isCurrentFamilyOwner(familyCode) {
      return request.auth != null 
        && isRealFamily(familyCode)
        && request.auth.token.familyCode == familyCode
        && isNotRevoked(familyCode)
        && (
          (firestore.exists(/databases/(default)/documents/beeyou_families/$(familyCode)) && firestore.get(/databases/(default)/documents/beeyou_families/$(familyCode)).data.ownerUid == request.auth.uid)
          || request.auth.token.get('role', '') == 'admin'
          || request.auth.token.get('admin', false) == true
        );
    }

    function isValidFamilyWrite(familyCode) {
      return isCurrentFamilyOwner(familyCode)
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'))
        && request.resource.metadata != null
        && request.resource.metadata.get('familyCode', '') == familyCode
        && request.resource.metadata.get('userId', '') == request.auth.uid;
    }

    match /beeyou/families/{familyCode}/{allPaths=**} {
      // Demo isolated sandbox
      allow read: if request.auth != null 
        && familyCode == 'BEE-DEMO' 
        && request.auth.token.get('email', '') == 'demo@beeyou.app';
      allow write: if request.auth != null 
        && familyCode == 'BEE-DEMO' 
        && request.auth.token.get('email', '') == 'demo@beeyou.app'
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));

      // Real families:
      // Reads: Authorized non-revoked members
      allow read: if isCurrentFamilyMember(familyCode);

      // Writes & Updates: Authorized non-revoked family owners/admins
      allow create, update: if isValidFamilyWrite(familyCode);

      // Deletes: Strictly authorized family owner or administrator
      allow delete: if isCurrentFamilyOwner(familyCode);
    }

    // Shared durable TTS audio cache across all users and serverless instances
    // Public read allows fast global CDN distribution; writes strictly restricted to trusted backend/admin
    match /tts_cache/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
        && (request.auth.token.get('admin', false) == true || request.auth.token.get('role', '') == 'admin' || request.auth.token.get('backend', false) == true)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
