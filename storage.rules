rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolated per-user storage (strictly authenticated)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated per-family custom icons and media
    // Strictly requires authenticated user and valid family code format
    match /beeyou/families/{familyCode}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        familyCode == 'BEE-DEMO' ||
        request.auth.token.email == 'demo@beeyou.app' ||
        familyCode.matches('^BEE-[A-Z0-9-]{3,16}$')
      );
    }

    // Block all unauthenticated or root access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
