rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolated per-user storage (strictly authenticated)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated per-family custom icons and media
    // Strictly requires authenticated user and verified family membership
    match /beeyou/families/{familyCode}/{allPaths=**} {
      allow read: if request.auth != null && (
        familyCode == 'BEE-DEMO' ||
        request.auth.token.email == 'demo@beeyou.app' ||
        request.auth.token.familyCode == familyCode ||
        resource.metadata.familyCode == familyCode ||
        resource.metadata.ownerUid == request.auth.uid ||
        resource.metadata.userId == request.auth.uid
      );
      allow write: if request.auth != null && (
        familyCode == 'BEE-DEMO' ||
        request.auth.token.email == 'demo@beeyou.app' ||
        request.auth.token.familyCode == familyCode ||
        (request.resource.metadata != null && request.resource.metadata.familyCode == familyCode && (request.resource.metadata.userId == request.auth.uid || request.resource.metadata.ownerUid == request.auth.uid))
      );
    }

    // Shared durable TTS audio cache across all users and serverless instances
    // Public read allows fast global CDN distribution; writes restricted to authenticated clients / backend
    match /tts_cache/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Block all unauthenticated or root access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
