rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default closed: prevent any unauthenticated or wildcard access
    match /{document=**} {
      allow read, write: if false;
    }

    match /beeyou_families/{familyCode} {
      // Family metadata read restricted to verified owner or backend
      allow read: if request.auth != null && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') == 'admin'
        || (request.auth.token.familyCode == familyCode && request.auth.uid == resource.data.ownerUid)
      );
      // Writes strictly restricted to backend / admin
      allow write: if request.auth != null && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') == 'admin'
        || request.auth.token.get('backend', false) == true
      );

      // Members subcollection
      match /members/{memberUid} {
        allow read: if request.auth != null && (
          request.auth.token.get('admin', false) == true
          || request.auth.token.get('role', '') == 'admin'
          || (request.auth.token.familyCode == familyCode && (request.auth.uid == memberUid || request.auth.token.get('role', '') == 'owner' || request.auth.token.get('isOwner', false) == true))
        );
        allow write: if request.auth != null && (
          request.auth.token.get('admin', false) == true
          || request.auth.token.get('role', '') == 'admin'
          || request.auth.token.get('backend', false) == true
        );
      }

      // Revoked members subcollection
      match /revokedMembers/{memberUid} {
        allow read: if request.auth != null && (
          request.auth.token.get('admin', false) == true
          || request.auth.token.get('role', '') == 'admin'
          || (request.auth.token.familyCode == familyCode && (request.auth.token.get('role', '') == 'owner' || request.auth.token.get('isOwner', false) == true))
        );
        allow write: if request.auth != null && (
          request.auth.token.get('admin', false) == true
          || request.auth.token.get('role', '') == 'admin'
          || request.auth.token.get('backend', false) == true
        );
      }
    }
  }
}
